# Address which receives the USDC charge for each proof review.
# Keep this as an EVM address; never commit a private key.
X402_PAY_TO=0xYourReceiverAddress

# x402's public facilitator is appropriate for a prototype. Configure an
# authenticated production facilitator separately before handling real payments.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional OpenAI-compatible model endpoint. Without these, the agent refuses
# to invent an assessment and returns a configuration error.
MODEL_API_URL=https://api.openai.com/v1/responses
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
PORT=3000
